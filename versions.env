# MariaDB release that every target is built from (source tarball from archive.mariadb.org).
MARIADB_VERSION=11.8.9
MARIADB_SHA256=2e015b7e91004142eda8b3a20d3ceb875cf2ae55e72603e7222cd497d4e56fc6
# Bump when the build changes but MariaDB does not. The release tag is v${MARIADB_VERSION}-r${REVISION}.
REVISION=1
# OpenSSL linked statically into the Linux / macOS packages (Windows uses the bundled wolfSSL + Schannel).
OPENSSL_VERSION=3.5.9
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
